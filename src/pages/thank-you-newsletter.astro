---
// Confirmation page for the footer newsletter form. noindex + excluded from the sitemap.
// Fires GA4 sign_up (not generate_lead): a newsletter sign-up isn't a lead.
import { agent } from '../data/agent';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadConfirm from '../components/LeadConfirm.astro';
---

<BaseLayout
  title="You're Subscribed | Selling 303"
  description="Thanks for subscribing to Jacob Stark's South Denver Metro market updates."
  ogUrl="https://selling303.com/thank-you-newsletter"
  headerVariant="solid"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <section class="ty">
    <div class="container ty__inner">
      <span class="ty__label">You're on the list</span>
      <h1>Thanks for Subscribing</h1>
      <p class="ty__lead">You'll get South Denver Metro market updates and practical advice for buyers and sellers. No spam, and you can unsubscribe anytime.</p>
      <div class="ty__btns">
        <a href="/blog" class="btn btn--primary">Read the Latest Posts</a>
        <a href={agent.phoneHref} class="btn btn--outline-dark">Call or Text {agent.phone}</a>
      </div>
    </div>
  </section>
  <LeadConfirm eventName="sign_up" />
</BaseLayout>

<style>
  .ty { background: var(--color-background); padding: calc(var(--header-height) + 4rem) 0 5rem; }
  .ty__inner { max-width: 720px; }
  .ty__label { display: block; margin-bottom: 0.75rem; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: #8a5a2b; font-weight: 700; }
  .ty h1 { margin: 0 0 1rem; font-family: var(--font-heading); font-weight: 400; font-size: clamp(2.25rem, 5vw, 3.25rem); line-height: 1.1; color: var(--color-primary); }
  .ty__lead { font-size: 1.15rem; line-height: 1.6; color: #4a5458; margin: 0 0 1.75rem; }
  .ty__btns { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
