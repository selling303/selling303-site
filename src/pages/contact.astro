---
import { agent } from '../data/agent';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact Jacob Stark | Selling 303 — Schedule a Call"
  description="Get in touch with Jacob Stark, South Denver Metro REALTOR. Schedule a call, send a message, or reach out directly at 303-997-0634."
  ogUrl="https://selling303.com/contact"
  currentPage="contact"
  headerVariant="solid"
>
  <Fragment slot="head">
    <!-- Schema: ContactPage -->
    <script type="application/ld+json" is:inline>
    {
      "@context":"https://schema.org",
      "@type":"ContactPage",
      "name":"Contact Jacob Stark | Selling 303",
      "url":"https://selling303.com/contact",
      "description":"Get in touch with Jacob Stark, South Denver Metro REALTOR.",
      "mainEntity":{"@type":"Person","name":"Jacob Stark","telephone":"+1-303-997-0634","email":"jacob@selling303.com"}
    }
    </script>
  </Fragment>

  <!-- ========== PAGE HERO ========== -->
  <PageHero
    label="Get in Touch"
    heading="Contact Jacob"
    subtext="No pressure, no pitch — just a conversation about your goals."
  />

  <!-- ========== CONTACT SECTION ========== -->
  <!-- Text-first layout (2026-10-14): real online leads text or email Jacob directly;
       the form is secondary and protected by Netlify reCAPTCHA. -->
  <section class="section section--white">
    <div class="container">
      <div class="contact-grid">
        <!-- LEFT: DIRECT CONTACT (primary) -->
        <div>
          <h2 class="section-heading">The Fastest Way to Reach Me</h2>
          <p style="margin-bottom: var(--space-lg);">Send me a text. I usually reply within a few hours. Tell me a little about your situation, like where you live now, what you're thinking about, and your rough timing.</p>

          <div class="contact-actions">
            <a href="sms:+13039970634?&body=Hi%20Jacob%2C%20I%20found%20you%20on%20selling303.com%20and%20" class="btn btn--primary btn--lg">Text Jacob: 303-997-0634</a>
            <a href={agent.phoneHref} class="btn btn--outline-dark">Call 303-997-0634</a>
            <a href="mailto:jacob@selling303.com" class="btn btn--outline-dark">Email jacob@selling303.com</a>
            <a href={agent.bookingUrls.general} class="btn btn--outline-dark" target="_blank" rel="noopener">Book 30 Minutes on My Calendar</a>
          </div>

          <div style="margin-top: var(--space-xl);">
            <h3 style="margin-bottom: var(--space-sm);">Service Area</h3>
            <p>I specialize in 9 South Denver Metro communities: Littleton, Highlands Ranch, Centennial, Englewood, Parker, Lakewood, Lone Tree, Castle Pines, and Greenwood Village. Covering Arapahoe, Douglas, and Jefferson counties.</p>
          </div>
        </div>

        <!-- RIGHT: FORM (secondary) -->
        <div class="contact-form-card">
          <h2 class="section-heading">Prefer to Send a Message?</h2>
          <p style="margin-bottom: var(--space-lg);">Fill this out and I'll get back to you within a few hours.</p>
          <form class="form" name="contact" method="POST" netlify-honeypot="bot-field" data-netlify="true" data-netlify-recaptcha="true" action="/thank-you">
            <input type="hidden" name="form-name" value="contact">
            <div style="position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden;" aria-hidden="true">
              <label>Don't fill this out if you're human: <input name="bot-field" type="text" tabindex="-1" autocomplete="off" /></label>
            </div>
            <div class="form__row">
              <div class="form__group">
                <label class="form__label" for="contact-name">Name</label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  class="form__input"
                  placeholder="First Last"
                  required
                />
              </div>
              <div class="form__group">
                <label class="form__label" for="contact-email">Email</label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  class="form__input"
                  placeholder="you@email.com"
                  required
                />
              </div>
            </div>
            <div class="form__group">
              <label class="form__label" for="contact-phone">Phone</label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                class="form__input"
                placeholder="(303) 555-0000"
              />
            </div>
            <div class="form__group">
              <label class="form__label" for="contact-interest">I'm interested in...</label>
              <select id="contact-interest" name="interest" class="form__select">
                <option value="">Select one</option>
                <option value="buying">Buying a Home</option>
                <option value="selling">Selling a Home</option>
                <option value="both">Buying &amp; Selling</option>
                <option value="investing">Investment Property</option>
                <option value="valuation">Home Valuation</option>
                <option value="other">Something Else</option>
              </select>
            </div>
            <div class="form__group">
              <label class="form__label" for="contact-message">Message</label>
              <textarea
                id="contact-message"
                name="message"
                class="form__textarea"
                placeholder="Tell me about your timeline, budget, neighborhood preferences, or anything else that's helpful."
                rows="5"
              ></textarea>
            </div>
            <div class="contact-recaptcha" data-netlify-recaptcha="true"></div>
            <button type="submit" class="btn btn--primary">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-actions { display: flex; flex-direction: column; gap: 0.75rem; max-width: 420px; }
  .contact-actions .btn { width: 100%; text-align: center; }
  .contact-form-card { background: var(--color-background); border: 1px solid var(--color-border); border-radius: 16px; padding: 1.75rem; }
  .contact-recaptcha { margin: 0 0 1rem; }
</style>
