---
import { agent } from '../data/agent';
import { Image } from 'astro:assets';
import jacobHomeSrc from '../assets/images/jacob-lifestyle-home.jpg';

const serviceAreas = [
  { name: 'Littleton', slug: 'littleton' },
  { name: 'Highlands Ranch', slug: 'highlands-ranch' },
  { name: 'Centennial', slug: 'centennial' },
  { name: 'Englewood', slug: 'englewood' },
  { name: 'Parker', slug: 'parker' },
  { name: 'Lakewood', slug: 'lakewood' },
  { name: 'Lone Tree', slug: 'lone-tree' },
  { name: 'Castle Pines', slug: 'castle-pines' },
  { name: 'Greenwood Village', slug: 'greenwood-village' },
];
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contact Jacob Stark | Selling 303 — Schedule a Call"
  description="Get in touch with Jacob Stark, South Denver Metro REALTOR. Schedule a call, send a message, or reach out directly at 303-997-0634."
  ogUrl="https://selling303.com/contact"
  currentPage="contact"
  headerVariant="solid"
>
  <Fragment slot="head">
    <!-- Schema: ContactPage -->
    <script type="application/ld+json" is:inline>
    {
      "@context":"https://schema.org",
      "@type":"ContactPage",
      "name":"Contact Jacob Stark | Selling 303",
      "url":"https://selling303.com/contact",
      "description":"Get in touch with Jacob Stark, South Denver Metro REALTOR.",
      "mainEntity":{"@type":"Person","name":"Jacob Stark","telephone":"+1-303-997-0634","email":"jacob@selling303.com"}
    }
    </script>
  </Fragment>

  <!-- ========== PAGE HERO ========== -->
  <PageHero
    label="Get in Touch"
    heading="Contact Jacob"
    subtext="No pressure, no pitch — just a conversation about your goals."
  />

  <!-- ========== CONTACT SECTION ========== -->
  <!-- Text-first layout (2026-10-14): real online leads text, call, or email Jacob
       directly. The contact form was removed (it only ever received spam). -->
  <section class="section section--white">
    <div class="container">
      <div class="contact-grid">
        <!-- LEFT: DIRECT CONTACT (primary) -->
        <div>
          <h2 class="section-heading">The Fastest Way to Reach Me</h2>
          <p style="margin-bottom: var(--space-lg);">Send me a text. I usually reply within a few hours. Tell me a little about your situation, like where you live now, what you're thinking about, and your rough timing.</p>

          <div class="contact-actions">
            <a href="sms:+13039970634?&body=Hi%20Jacob%2C%20I%20found%20you%20on%20selling303.com%20and%20" class="btn btn--primary btn--lg">Text Jacob: 303-997-0634</a>
            <a href={agent.phoneHref} class="btn btn--outline-dark">Call 303-997-0634</a>
            <a href="mailto:jacob@selling303.com" class="btn btn--outline-dark">Email jacob@selling303.com</a>
            <a href={agent.bookingUrls.general} class="btn btn--outline-dark" target="_blank" rel="noopener">Book 30 Minutes on My Calendar</a>
          </div>

        </div>

        <!-- RIGHT: PHOTO -->
        <div class="contact-photo">
          <Image src={jacobHomeSrc} alt="Jacob Stark, South Denver Metro REALTOR, at home in his living room" width={800} format="webp" quality={80} loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- ========== SERVICE AREA (below the fold, local SEO + internal links) ========== -->
  <section class="section contact-area">
    <div class="container">
      <h2 class="contact-area__title">Serving the South Denver Metro</h2>
      <p class="contact-area__text">Arapahoe, Douglas, and Jefferson counties, including:</p>
      <ul class="contact-area__list">
        {serviceAreas.map((a) => (
          <li><a href={`/neighborhoods/${a.slug}`}>{a.name}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-actions { display: flex; flex-direction: column; gap: 0.75rem; max-width: 420px; }
  .contact-actions .btn { width: 100%; text-align: center; }
  .contact-photo img { width: 100%; height: 100%; max-height: 520px; object-fit: cover; object-position: 48% 40%; border-radius: 16px; display: block; }
  .contact-area { background: var(--color-background); padding-top: var(--space-xl); padding-bottom: var(--space-xl); }
  .contact-area__title { font-family: var(--font-heading); font-weight: 400; font-size: 1.5rem; color: var(--color-primary); margin: 0 0 0.25rem; }
  .contact-area__text { color: #4a5458; margin: 0 0 1rem; }
  .contact-area__list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .contact-area__list a { display: inline-block; padding: 0.4rem 0.9rem; border: 1px solid var(--color-border); border-radius: 999px; background: #fff; color: var(--color-primary); text-decoration: none; font-size: 0.95rem; }
  .contact-area__list a:hover { border-color: var(--color-primary); }
</style>
