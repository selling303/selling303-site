---
import { agent, brokerage } from '../data/agent';
import BaseLayout from '../layouts/BaseLayout.astro';
import RealScoutLoader from '../components/RealScoutLoader.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

// Homepage (2026-10 redesign, "Outgrown Your Home?" direction D3).
// Hero proof: 18302 E Hampden Pl (seller bought first; paint, carpet, staging; sold at list in 3 days).
import familyBefore from '../assets/images/before-after/hampden-living-room-before.jpg';
import familyAfter from '../assets/images/success-stories/18302-e-hampden-pl-aurora/18-F9A6241.jpg';
import primaryBefore from '../assets/images/before-after/hampden-primary-bedroom-before.jpg';
import primaryAfter from '../assets/images/success-stories/18302-e-hampden-pl-aurora/23-F9A6284.jpg';
import headshot from '../assets/images/jacob-stark-headshot.png';

const bookUrl = agent.bookingUrls.general;

// Success-story strip: slugs + one-line results. Every figure here comes from the story's own page.
const storyTiles = [
  { slug: '14556-w-3rd-ave-golden', eyebrow: 'Golden · Bought first', result: 'Sold $55,000 over list in 4 days', detail: 'After buying their dream home first' },
  { slug: '7307-s-birch-st-centennial', eyebrow: 'Centennial · Bought & sold', result: 'Sold $82,000 over list in 4 days', detail: 'Then landed their next home before a bidding war' },
  { slug: '6566-s-flower-st-littleton', eyebrow: 'Littleton · Pre-sale updates', result: 'Sold at full asking price', detail: 'Patio, carpet, paint, and tile with no upfront cost' },
  { slug: '2993-s-jericho-ct-aurora', eyebrow: 'Aurora · Prepared to sell', result: 'Sold $31,000 over list in 4 days', detail: 'New carpet, deep clean, and staging' },
  { slug: '21069-woodside-ln-parker', eyebrow: 'Parker · Holiday listing', result: 'Sold over list price', detail: 'While neighboring listings sat unsold' },
  { slug: '6718-s-holland-way-littleton', eyebrow: 'Littleton · Next home lined up', result: 'Sold over asking in 4 days', detail: 'Fast enough to secure an off-market home' },
];
const storyImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/success-stories/**/*.{jpg,jpeg,png,webp}', { eager: true });
const allStories = await getCollection('successStories');
const tiles = storyTiles.map((t) => {
  const entry = allStories.find((s) => s.id === t.slug);
  if (!entry) return null;
  const key = Object.keys(storyImages).find((k) => k.includes(entry.data.heroImage.src));
  return { ...t, href: `/sell/success-stories/${t.slug}`, img: key ? storyImages[key].default : null, alt: entry.data.heroImage.alt };
}).filter((t) => t !== null);

// "What's your situation?" router. Default panel renders server-side; the script swaps panels.
const situations = [
  { key: 'fix', label: 'Selling, not sure what to fix', eyebrow: 'Prepare to Sell', title: 'What to fix before selling, and what to skip', body: 'Most of what is stressing you will not change your sale price. A few things will. Here is how to tell the difference.', cta: 'See what to fix', href: '/what-to-fix-before-selling' },
  { key: 'first', label: 'Buying our first home', eyebrow: 'First-Time Buyers', title: 'Your first home, without the guesswork', body: 'Budget, pre-approval, neighborhoods, and offers that win, explained step by step.', cta: 'Start here', href: '/first-time-homebuyers' },
  { key: 'firstsell', label: 'Selling our first home', eyebrow: 'First-Time Sellers', title: 'Selling for the first time? Here is the whole process.', body: 'Pricing, prep, showings, offers, and closing costs, so nothing catches you off guard.', cta: 'Learn the process', href: '/first-time-homesellers' },
  { key: 'moving', label: 'Moving to the Denver area', eyebrow: 'Relocation', title: 'Find the right South Denver Metro neighborhood', body: 'Compare Littleton, Highlands Ranch, Centennial, Parker, and more before you ever fly in.', cta: 'Compare neighborhoods', href: '/relocation' },
  { key: 'new', label: 'Building new', eyebrow: 'New Construction', title: 'Buying new construction with someone on your side', body: 'The builder has an agent. You should too. Incentives, lot selection, upgrades, and inspections.', cta: 'Explore new construction', href: '/new-construction' },
  { key: 'expired', label: 'Our listing expired', eyebrow: 'Expired Listings', title: 'What went wrong, and how to relist right', body: 'Pricing, prep, and marketing: a clear diagnosis before you try again.', cta: 'Diagnose my listing', href: '/expired-listings' },
];

const neighborhoods = [
  ['Littleton', 'littleton'], ['Highlands Ranch', 'highlands-ranch'], ['Centennial', 'centennial'],
  ['Parker', 'parker'], ['Englewood', 'englewood'], ['Lakewood', 'lakewood'],
  ['Lone Tree', 'lone-tree'], ['Castle Pines', 'castle-pines'], ['Greenwood Village', 'greenwood-village'],
];

// Pull testimonials from all published success stories so the homepage
// AggregateRating in BaseLayout's RealEstateAgent block is backed by real
// Review schema entries. Reviews attach to the same @id, so Google merges
// them with the existing agent profile.
const successStories = await getCollection('successStories', (entry) => !entry.data.draft);
const homepageReviewSchema = {
  "@context": "https://schema.org",
  "@type": ["Person", "RealEstateAgent"],
  "@id": "https://selling303.com/#agent",
  "review": successStories.flatMap((s) =>
    s.data.testimonials.map((t) => ({
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": t.rating,
        "bestRating": 5,
      },
      "author": { "@type": "Person", "name": t.name },
      "reviewBody": t.text,
      "datePublished": s.data.closeDate,
      "publisher": { "@id": "https://selling303.com/#organization" },
    }))
  ),
};

const ldSchema1 = {
  "@context": "https://schema.org",
  "@type": [
    "Person",
    "RealEstateAgent"
  ],
  "@id": "https://selling303.com/#agent",
  "name": "Jacob Stark",
  "alternateName": "Selling 303",
  "jobTitle": "REALTOR®",
  "url": "https://selling303.com/",
  "image": "https://selling303.com/images/jacob-stark-headshot.png",
  "telephone": "+1-303-997-0634",
  "email": "jacob@selling303.com",
  "description": "South Denver Metro REALTOR specializing in Littleton, Highlands Ranch, Centennial, Parker, and surrounding communities. Guiding buyers and sellers with clarity, confidence, and control.",
  "areaServed": [
    {
      "@type": "City",
      "name": "Littleton",
      "containedInPlace": {
        "@type": "State",
        "name": "Colorado"
      }
    },
    {
      "@type": "City",
      "name": "Highlands Ranch",
      "containedInPlace": {
        "@type": "State",
        "name": "Colorado"
      }
    },
    {
      "@type": "City",
      "name": "Centennial",
      "containedInPlace": {
        "@type": "State",
        "name": "Colorado"
      }
    },
    {
      "@type": "City",
      "name": "Englewood",
      "containedInPlace": {
        "@type": "State",
        "name": "Colorado"
      }
    },
    {
      "@type": "City",
      "name": "Parker",
      "containedInPlace": {
        "@type": "State",
        "name": "Colorado"
      }
    },
    {
      "@type": "City",
      "name": "Lakewood",
      "containedInPlace": {
        "@type": "State",
        "name": "Colorado"
      }
    },
    {
      "@type": "City",
      "name": "Lone Tree",
      "containedInPlace": {
        "@type": "State",
        "name": "Colorado"
      }
    },
    {
      "@type": "City",
      "name": "Castle Pines",
      "containedInPlace": {
        "@type": "State",
        "name": "Colorado"
      }
    },
    {
      "@type": "City",
      "name": "Greenwood Village",
      "containedInPlace": {
        "@type": "State",
        "name": "Colorado"
      }
    }
  ],
  "worksFor": {
    "@type": "Organization",
    "name": brokerage.name,
    "url": brokerage.url
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Greenwood Village",
    "addressRegion": "CO",
    "postalCode": "80111",
    "addressCountry": "US"
  },
  "knowsAbout": [
    "home selling",
    "home buying",
    "real estate pricing strategy",
    "South Denver Metro real estate",
    "comparative market analysis",
    "real estate negotiation",
    "investment property analysis"
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "Professional Certification",
      "name": "Real Estate Negotiation Expert (RENE)"
    }
  ],
  "award": [
    "DMAR Excellence Award — Silver Level (2024)",
    "DMAR Excellence Award — Gold Level (2025)",
    "DMAR Excellence Award — Silver Level (2026)",
    "5280 Magazine Top Real Estate Producer — Black Diamond",
    "Real Trends Verified"
  ],
  "memberOf": [
    {
      "@type": "Organization",
      "name": "Denver Metro Association of REALTORS (DMAR)"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": agent.stats.googleRating,
    "reviewCount": agent.stats.googleReviewCount,
    "bestRating": "5"
  },
  "sameAs": [
    brokerage.agentProfileUrl,
    "https://www.google.com/maps/place/?q=Jacob+Stark+Real+Estate",
    "https://www.zillow.com/profile/jacobstarkrealtor",
    "https://www.realtor.com/realestateagents/5ef4c015aa95460011ac4a5b",
    "https://www.linkedin.com/in/jacobstark",
    "https://www.instagram.com/jacobstark_realtor/",
    "https://www.facebook.com/jacobstarkrealtor/",
    "https://www.youtube.com/@selling303",
    "https://www.youtube.com/channel/UCTr7LNftWL7F63Bw-rcdxLg",
    "https://www.fastexpert.com/agents/jacob-stark-109720/",
    "https://www.homes.com/real-estate-agents/jacob-stark/fr1k64r/",
    "https://nextdoor.com/pages/jacob-stark-realtor-greenwood-village-co/",
    "https://www.realtrends.com/agent-profile/jacob-stark-colorado/",
    "https://directory.5280.com/real_estate_agent/jacob-stark/",
    "https://www.wikidata.org/wiki/Q139385406"
  ]
};

const ldSchema2 = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://selling303.com/#organization",
  "name": "Selling 303",
  "alternateName": "Selling303",
  "url": "https://selling303.com",
  "logo": {
    "@type": "ImageObject",
    "url": "https://selling303.com/images/selling303-logo.png"
  },
  "description": `Selling 303 is the South Denver Metro real estate practice of REALTOR Jacob Stark at ${brokerage.name}, serving Littleton, Highlands Ranch, Centennial, Englewood, Parker, Lone Tree, Castle Pines, Lakewood, and Greenwood Village.`,
  "founder": {
    "@id": "https://selling303.com/#agent"
  },
  "employee": {
    "@id": "https://selling303.com/#agent"
  },
  "sameAs": [
    "https://www.instagram.com/jacobstark_realtor/",
    "https://www.facebook.com/jacobstarkrealtor/",
    "https://www.youtube.com/@selling303",
    "https://www.linkedin.com/in/jacobstark"
  ]
};
---

<BaseLayout
  title="Jacob Stark | Littleton, CO REALTOR® | Outgrown Your Home?"
  description="Outgrown your home? Jacob Stark, a Littleton, Colorado REALTOR®, helps South Denver Metro families buy first, sell later, and move just once."
  ogTitle="Outgrown Your Home? | Jacob Stark, South Denver Metro REALTOR®"
  ogDescription="Buy and move first, sell later. Move just once. Update your home to sell for more, and pay for updates at closing. Jacob Stark helps South Denver Metro families move up with a plan."
  ogUrl="https://selling303.com"
  currentPage="home"
  headerVariant="solid"
>
  <Fragment slot="head">
    <style>
      realscout-home-value {
        --rs-hvw-background-color: #ffffff;
        --rs-hvw-title-color: #002a3a;
        --rs-hvw-subtitle-color: #4a5458;
        --rs-hvw-primary-button-text-color: #1a1a1a;
        --rs-hvw-primary-button-color: #c8965a;
        --rs-hvw-secondary-button-text-color: #ffffff;
        --rs-hvw-secondary-button-color: #002a3a;
        --rs-hvw-widget-width: auto;
      }
    </style>

    <!-- Schema: Person + RealEstateAgent (unified entity) -->
    <script type="application/ld+json" set:html={JSON.stringify(ldSchema1)}></script>

    <!-- Schema: Organization (Selling 303 brand entity). Canonical "@id" used as the
         publisher reference across all Article schema. -->
    <script type="application/ld+json" set:html={JSON.stringify(ldSchema2)}></script>

    <!-- Schema: Reviews backing the AggregateRating above, pulled from published
         success-story testimonials. Same @id as the agent block. -->
    <script type="application/ld+json" set:html={JSON.stringify(homepageReviewSchema)}></script>
  </Fragment>

  <!-- ========== 1 · HERO: THE QUESTION, THEN "DID YOU KNOW YOU CAN" ========== -->
  <section class="hp-hero">
    <div class="container">
      <p class="hp-eyebrow">South Denver Metro · Jacob Stark, REALTOR®</p>
      <h1 class="hp-hero__title">Outgrown your home?</h1>
      <div class="hp-hero__grid">
        <div>
          <p class="hp-hero__lead">Did you know <span>you can…</span></p>
          <ul class="hp-cans" id="hp-cans">
            <li><span class="hp-check" aria-hidden="true">✓</span><span>Buy and move first, sell later</span></li>
            <li><span class="hp-check" aria-hidden="true">✓</span><span>Move just once</span></li>
            <li><span class="hp-check" aria-hidden="true">✓</span><span>Update your home to sell for more</span></li>
            <li><span class="hp-check" aria-hidden="true">✓</span><span>Skip the constant cleaning for showings</span></li>
            <li><span class="hp-check" aria-hidden="true">✓</span><span>Pay for updates at closing<sup>*</sup></span></li>
          </ul>
          <div class="hp-btns">
            <a href={bookUrl} class="btn btn--primary btn--lg hp-btn-navy" target="_blank" rel="noopener">Get Your Next-Move Plan</a>
            <a href="#plan" class="btn btn--lg hp-btn-ghost">See How It Works ↓</a>
          </div>
          <p class="hp-trust">★ {agent.stats.googleRating} from {agent.stats.googleReviewCount} Google reviews · Free 30-minute call</p>
        </div>
        <div class="hp-hero__visual">
          <figure class="hp-hero__after">
            <Image src={familyAfter} alt="Family room after fresh paint, including the brick fireplace, and staging" width={900} format="webp" quality={80} loading="eager" fetchpriority="high" />
            <figcaption class="hp-tag hp-tag--after">After</figcaption>
          </figure>
          <figure class="hp-hero__before">
            <Image src={familyBefore} alt="The same family room before prep" width={480} format="webp" quality={78} loading="eager" />
            <figcaption class="hp-tag hp-tag--before">Before</figcaption>
          </figure>
          <p class="hp-hero__caption"><strong>Bought first. Updated after.</strong> Sold at list price in 3 days.</p>
        </div>
      </div>
      <p class="hp-footnote">*{brokerage.disclosures.equityAdvance} {brokerage.disclosures.renovationFinancingShort}</p>
    </div>
  </section>

  <!-- ========== 2 · WHAT'S YOUR SITUATION? (other visitors) ========== -->
  <section class="hp-section hp-section--white hp-border-top hp-router-sec">
    <div class="container hp-router">
      <div>
        <p class="hp-eyebrow">Not moving up?</p>
        <h2 class="hp-h2">What's your situation?</h2>
        <p class="hp-sub">Pick the one that sounds like you, and I'll point you to the right next step.</p>
        <div class="hp-chips" role="group" aria-label="Choose your situation">
          {situations.map((s, i) => (
            <button type="button" class="hp-chip" data-situation={s.key} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>
          ))}
        </div>
      </div>
      <div class="hp-panels" aria-live="polite">
        {situations.map((s, i) => (
          <div class="hp-panel" data-panel={s.key} hidden={i !== 0}>
            <p class="hp-panel__eyebrow">{s.eyebrow}</p>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <div class="hp-btns">
              <a href={s.href} class="btn btn--primary">{s.cta}</a>
              <a href={bookUrl} class="btn hp-btn-outline-light" target="_blank" rel="noopener">Talk to Jacob</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== 2 · GUIDE: EMPATHY + AUTHORITY ========== -->
  <section class="hp-guide">
    <div class="container">
      <div class="hp-guide__intro">
        <Image src={headshot} alt="Jacob Stark, South Denver Metro REALTOR®" width={320} format="webp" quality={80} class="hp-guide__photo" />
        <div>
          <h2>Moving up is a big decision. It shouldn't feel like a gamble.</h2>
          <p>Most people feel overwhelmed when it's time to buy or sell a home. I'm Jacob Stark, a South Denver Metro REALTOR®, and I guide you through every step so you feel clarity, confidence, and control, from the first conversation to closing day.</p>
        </div>
      </div>
      <div class="hp-stats">
        <div><span>{agent.stats.salesVolume}</span>in home sales</div>
        <div><span>{agent.stats.saleToList}</span>average list-to-close</div>
        <div><span>{agent.stats.avgDaysOnMarket}</span>average days on market</div>
        <div><span>{agent.stats.familiesHelped}</span>families helped</div>
      </div>
    </div>
  </section>

  <!-- ========== 3 · THE PLAN ========== -->
  <section class="hp-section hp-section--white" id="plan">
    <div class="container">
      <p class="hp-eyebrow">The Plan</p>
      <h2 class="hp-h2">Prepare. Buy &amp; Sell. Move Once.</h2>
      <p class="hp-sub">Three steps, built backward from the day you want to be in the new house.</p>
      <div class="hp-three">
        <a href="/what-to-fix-before-selling" class="hp-plan-card">
          <span class="hp-num">1</span>
          <h3>Prepare</h3>
          <p>What's worth fixing, what to skip, what it costs, and how long it takes, based on what buyers near you actually pay for.</p>
          <span class="hp-more">What to fix before selling →</span>
        </a>
        <a href="/buy-before-you-sell" class="hp-plan-card">
          <span class="hp-num">2</span>
          <h3>Buy &amp; Sell</h3>
          <p>For most families, the easiest path is buying the next home first, with a strong offer and no two-mortgage scramble.</p>
          <span class="hp-more">How to buy before you sell →</span>
        </a>
        <a href="/renovate-before-selling" class="hp-plan-card">
          <span class="hp-num">3</span>
          <h3>Move Once</h3>
          <p>You move straight in. The old house gets refreshed and staged into its most inviting version, then sold.</p>
          <span class="hp-more">Updates with no money upfront →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== 4 · SUCCESS: PRIMARY BEDROOM + TESTIMONIALS ========== -->
  <section class="hp-section">
    <div class="container">
      <p class="hp-eyebrow">What it looks like</p>
      <h2 class="hp-h2">She moved into her next home first. Then we got this one ready.</h2>
      <p class="hp-sub">Fresh paint, new carpet, and staging. We skipped the popcorn ceilings and the hall bath. It sold at list price in 3 days.</p>
      <div class="hp-pair">
        <figure>
          <Image src={primaryBefore} alt="Primary bedroom before: dated furniture, packed with belongings" width={800} format="webp" quality={78} loading="lazy" />
          <figcaption class="hp-tag hp-tag--before">Before</figcaption>
        </figure>
        <figure>
          <Image src={primaryAfter} alt="The same primary bedroom after paint, new carpet, and staging" width={800} format="webp" quality={78} loading="lazy" />
          <figcaption class="hp-tag hp-tag--after">After</figcaption>
        </figure>
      </div>

      <h2 class="hp-h2 hp-h2--spaced">What it's like to work together</h2>
      <div class="hp-three">
        <blockquote class="hp-quote">
          <p>"His communication, knowledge, expertise and dedication to our home sale and purchase were instrumental."</p>
          <cite>Matthew S. · Centennial</cite>
        </blockquote>
        <blockquote class="hp-quote">
          <p>"Jacob provided options for presenting the best of the home, not pressuring but leaving the decision to us."</p>
          <cite>Dee · Aurora</cite>
        </blockquote>
        <blockquote class="hp-quote">
          <p>"Jacob was strategic, patient, and realistic. He didn't make any promises that were unrealistic."</p>
          <cite>Daniel K. · Parker</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ========== 5 · SUCCESS STORIES STRIP ========== -->
  <section class="hp-section hp-section--white hp-border-top">
    <div class="container">
      <div class="hp-strip-head">
        <h2 class="hp-h2">Families who've made the move</h2>
        <a href="/sell/success-stories" class="hp-link">See all success stories →</a>
      </div>
      <div class="hp-strip">
        {tiles.map((t) => (
          <a href={t.href} class="hp-tile">
            {t.img && <Image src={t.img} alt={t.alt} width={600} format="webp" quality={75} loading="lazy" />}
            <div class="hp-tile__body">
              <p class="hp-tile__eyebrow">{t.eyebrow}</p>
              <h3>{t.result}</h3>
              <p>{t.detail}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== 7 · TOOLS ========== -->
  <section class="hp-section hp-section--white hp-border-top">
    <div class="container">
      <h2 class="hp-h2">Run your own numbers first</h2>
      <div class="hp-three">
        <a href="/tools/home-equity-calculator" class="hp-tool">
          <h3>Home equity calculator</h3>
          <p>See what you could put toward the next home. No email required.</p>
          <span class="hp-more">Open the calculator →</span>
        </a>
        <a href="/what-to-fix-before-selling" class="hp-tool">
          <h3>What to fix before selling</h3>
          <p>Room by room: what's worth doing before you list, what to skip, and roughly what it costs.</p>
          <span class="hp-more">Read the guide →</span>
        </a>
        <a href="/tools/closing-cost-estimator" class="hp-tool">
          <h3>Closing cost estimator</h3>
          <p>Estimate what you'll pay at closing, so the numbers on both homes hold up.</p>
          <span class="hp-more">Estimate closing costs →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== 8 · NEIGHBORHOODS ========== -->
  <section class="hp-section hp-border-top">
    <div class="container">
      <h2 class="hp-h2">Moving up across the South Denver Metro</h2>
      <div class="hp-hoods">
        {neighborhoods.map(([name, slug]) => (
          <a href={`/neighborhoods/${slug}`}>{name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== 9 · HOME VALUE ========== -->
  <section class="lead-capture" id="home-value">
    <div class="container">
      <div class="lead-capture__inner">
        <div>
          <span class="section-label">Curious What Your Home Could Sell For?</span>
          <h2>Find Out What Your Home Is Worth</h2>
          <p>Get a real-time estimate based on recent sales in your neighborhood. It's the first number in your next-move plan.</p>
        </div>
        <div>
          <realscout-home-value agent-encoded-id="QWdlbnQtMjg5MjYw"></realscout-home-value>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 10 · FINAL CTA ========== -->
  <section class="hp-final">
    <div class="container">
      <h2>You don't have to figure this out alone.</h2>
      <p>In 30 minutes, we'll sort out what's worth fixing, whether to buy or sell first, and a realistic timeline to the next house.</p>
      <div class="hp-btns hp-btns--center">
        <a href={bookUrl} class="btn btn--primary btn--lg" target="_blank" rel="noopener">Get Your Next-Move Plan</a>
