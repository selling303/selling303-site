<script>
  // Hero "you can" drum (mobile only): one line in focus, neighbors faded.
  // Full list stays in the DOM; reduced-motion users and desktop get the static list.
  const cans = document.getElementById('hp-cans');
  if (cans) {
    const items = Array.from(cans.querySelectorAll('li'));
    const mq = window.matchMedia('(max-width: 900px) and (prefers-reduced-motion: no-preference)');
    let i = 0;
    let timer: number | undefined;
    const paint = () => {
      const n = items.length;
      items.forEach((li, k) => {
        const d = (k - i + n) % n;
        li.dataset.pos = d === 0 ? 'active' : d === 1 ? 'next' : d === n - 1 ? 'prev' : d < n / 2 ? 'below' : 'above';
      });
    };
    const step = () => { i = (i + 1) % items.length; paint(); };
    const start = () => { stop(); timer = window.setInterval(step, 2600); };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const apply = () => {
      if (mq.matches) { cans.classList.add('hp-cans--drum'); paint(); start(); }
      else { cans.classList.remove('hp-cans--drum'); items.forEach((li) => delete li.dataset.pos); stop(); }
    };
    cans.addEventListener('click', () => { if (cans.classList.contains('hp-cans--drum')) { step(); start(); } });
    mq.addEventListener('change', apply);
    apply();
  }

  // "What's your situation?" router: swap the visible panel when a chip is chosen.
  document.querySelectorAll<HTMLButtonElement>('.hp-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.situation;
      document.querySelectorAll<HTMLButtonElement>('.hp-chip').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      document.querySelectorAll<HTMLElement>('.hp-panel').forEach((p) => { p.hidden = p.dataset.panel !== key; });
    });
  });
</script>

