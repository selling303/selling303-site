---
import { agent, brokerage } from '../data/agent';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RealScoutLoader from '../components/RealScoutLoader.astro';
---

<BaseLayout
  title="Properties | Selling 303 — Jacob Stark Listings"
  description="Browse Jacob Stark's current and recent listings across South Denver Metro. View homes for sale, in contract, and sold properties in Littleton, Highlands Ranch, Centennial, and beyond."
  ogUrl="https://selling303.com/properties"
  currentPage="properties"
  headerVariant="solid"
>
  <Fragment slot="head">
    <style is:inline>
      realscout-your-listings {
        --rs-listing-divider-color: #c8965a;
        width: 100%;
      }
    </style>

    <!-- Schema: WebPage -->
    <script type="application/ld+json" is:inline>
    {
      "@context":"https://schema.org",
      "@type":"WebPage",
      "name":"Properties | Selling 303",
      "url":"https://selling303.com/properties",
      "description":"Browse Jacob Stark's current and recent listings across South Denver Metro.",
      "author":{
        "@type":"Person",
        "name":"Jacob Stark"
      }
    }
    </script>
  </Fragment>

  <!-- ========== PAGE HERO ========== -->
  <PageHero
    label="Listings"
    heading="My Properties"
    subtext="Current, in-contract, and recent sales across the South Denver Metro"
  />

  <!-- ========== REALSCOUT LISTINGS ========== -->
  <section class="section section--white">
    <div class="container">
      <!-- Crawlable intro: the RealScout widget loads client-side, so without this
           text Google sees an almost empty page. -->
      <div class="properties-intro">
        <h2 class="section-heading">Homes Jacob Stark Has Listed and Sold in the South Denver Metro</h2>
        <p>These are my current, in-contract, and recently sold listings with {brokerage.name} across Littleton, Highlands Ranch, Centennial, Englewood, Parker, Lakewood, Lone Tree, Castle Pines, and Greenwood Village. I focus on families who've outgrown their home and need to sell one house and buy the next, and every listing starts with a plan for pricing, prep, and timing under my <a href="/my-seller-promise">Seller Promise</a>.</p>
        <p>Across $50M+ in closed sales, my listings have a 101.8% sale-to-list ratio. Want the story behind a sale? Read my <a href="/sell/success-stories">success stories</a>. Thinking about your next move? See <a href="/buy-before-you-sell">how to buy your next home before selling</a>, or call or text me at <a href={agent.phoneHref}>{agent.phone}</a>.</p>
      </div>
      <realscout-your-listings
        agent-encoded-id="QWdlbnQtMjg5MjYw"
        sort-order="STATUS_AND_SIGNIFICANT_CHANGE"
        listing-status="For Sale,For Rent,In Contract,Sold,Rented"
        property-types="SFR,MF,TC,LAL,MOBILE,OTHER"
        include-co-listings
        include-seller-listings
        style="--rs-listing-divider-color: #c8965a;"
      ></realscout-your-listings>
    </div>
  </section>

  <RealScoutLoader />
</BaseLayout>

<style>
  .properties-intro { max-width: 760px; margin: 0 auto var(--space-xl); }
  .properties-intro p { color: #3d4549; line-height: 1.7; margin: 0 0 1rem; }
  .properties-intro a { color: var(--color-primary); text-decoration: underline; }
</style>
